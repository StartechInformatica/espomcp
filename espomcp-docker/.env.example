# ===== EspoCRM =====
ESPOCRM_URL=https://crm.tuodominio.it
ESPOCRM_API_KEY=incolla-qui-la-api-key-dell-utente-API
ESPOCRM_AUTH_METHOD=apikey
# Solo se ESPOCRM_AUTH_METHOD=hmac
ESPOCRM_SECRET_KEY=

# ===== Server MCP =====
# Genera con: openssl rand -hex 32
MCP_AUTH_TOKEN=cambia-questo-token
# Token opzionale che espone SOLO i tool di lettura (search_*, get_*, health_check)
MCP_AUTH_TOKEN_READONLY=
# Tool nascosti a tutti, separati da virgola (es. delete_entity,assign_role_to_user)
MCP_TOOLS_DENY=
# Annotazioni readOnly/destructive sui tool (usate da TrueForge per approvazioni e @read-only)
MCP_TOOL_ANNOTATIONS=true
# Override lista tool "distruttivi" (default: delete_entity,update_entity,unlink_entities,remove_user_from_team,assign_role_to_user)
MCP_DESTRUCTIVE_TOOLS=
# Rete Docker condivisa con TrueForge
MCP_SHARED_NETWORK=mcp-net
MCP_HOST_PORT=3000
MCP_PATH=/mcp
# true = accetta anche https://host/mcp/<token> (necessario per claude.ai)
MCP_ALLOW_PATH_TOKEN=true
MCP_JSON_RESPONSE=true
MCP_SESSION_TTL_MINUTES=60
MCP_MAX_SESSIONS=50

# ===== Varie =====
RATE_LIMIT=100
REQUEST_TIMEOUT=30000
LOG_LEVEL=info
